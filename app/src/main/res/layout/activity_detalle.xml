<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gris_oscuro"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/gris_oscuro"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationIconTint="@color/blanco"
        app:subtitleTextColor="#B0BEC5"
        app:titleTextColor="@color/blanco" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fondo">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- valor actual (sensor) o estado (actuador) -->
            <LinearLayout
                android:id="@+id/cajaValor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/fondo_tarjeta"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp">

                <ImageView
                    android:id="@+id/imgIcono"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/fondo_icono"
                    android:contentDescription="Icono"
                    android:padding="12dp"
                    app:tint="@color/naranjo" />

                <TextView
                    android:id="@+id/txtValor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="-"
                    android:textColor="@color/texto"
                    android:textSize="40sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtEstado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/texto_secundario" />

                <Button
                    android:id="@+id/btnCambiar"
                    style="@style/BotonNaranjo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txtUltimoCambio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/texto_secundario"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- historial (solo sensores) -->
            <LinearLayout
                android:id="@+id/cajaHistorial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/TituloSeccion"
                    android:text="HISTORIAL" />

                <RadioGroup
                    android:id="@+id/rgRango"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rb1h"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:checked="true"
                        android:text="1 hora" />

                    <RadioButton
                        android:id="@+id/rb24h"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="24 horas" />

                    <RadioButton
                        android:id="@+id/rb7d"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="7 días" />
                </RadioGroup>

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/grafico"
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/fondo_tarjeta"
                    android:padding="8dp" />

                <TextView
                    android:id="@+id/txtResumen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/fondo_tarjeta"
                    android:lineSpacingExtra="4dp"
                    android:padding="12dp"
                    android:textColor="@color/texto" />
            </LinearLayout>

            <TextView
                style="@style/TituloSeccion"
                android:text="INFORMACIÓN" />

            <TextView
                android:id="@+id/txtInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/fondo_tarjeta"
                android:lineSpacingExtra="4dp"
                android:padding="12dp"
                android:textColor="@color/texto" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
