<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gris_oscuro"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/gris_oscuro"
        app:subtitleTextColor="#B0BEC5"
        app:titleTextColor="@color/blanco" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fondo">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- estado de la Raspberry Pi -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/fondo_tarjeta"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/imgEstadoPi"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:contentDescription="Estado"
                        android:src="@drawable/punto"
                        app:tint="@color/texto_secundario" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtEstadoPi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Raspberry Pi: conectando..."
                            android:textColor="@color/texto"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtActualizado"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/texto_secundario"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- aviso cuando un sensor esta fuera de rango o no hay conexion -->
                <TextView
                    android:id="@+id/txtAviso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/fondo_alerta"
                    android:padding="12dp"
                    android:textColor="@color/rojo"
                    android:visibility="gone" />

                <TextView
                    style="@style/TituloSeccion"
                    android:text="SENSORES" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerSensores"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/TituloSeccion"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="ACTUADORES" />

                    <TextView
                        android:id="@+id/txtSoloLectura"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Solo lectura"
                        android:textColor="@color/texto_secundario"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerActuadores"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Se actualiza cada 3 segundos. Toca un dispositivo para ver el detalle."
                    android:textColor="@color/texto_secundario"
                    android:textSize="12sp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
